# Configuração do Zóio. Fica em /etc/zoio/zoio.env, legível só pelo serviço.

# DVR (Xiongmai AHB8004R-MH-NVT)
DVR_HOST=192.168.15.6
DVR_USER=admin
DVR_PASS=
# DVR_PORT=34567
# DVR_RTSP_PORT=554

# Câmeras: quantos canais e o nome de cada um, na ordem do DVR.
ZOIO_CHANNELS=8
ZOIO_CHANNEL_NAMES=Câmera 1,Câmera 2,Câmera 3,Câmera 4,Câmera 5,Câmera 6,Câmera 7,Câmera 8
# Canais sem câmera ligada (não aparecem no app), ex.: 7,8
# ZOIO_HIDE_CHANNELS=

# Aprovação de aparelhos: cada aparelho cria uma chave própria e só entra
# depois de aprovado (no app, por um aparelho administrador, ou no Pi com
# `sudo zoio aparelhos aprovar CÓDIGO`). Deixe ligado.
ZOIO_DEVICE_APPROVAL=1
# Dias que uma sessão vale sem uso (o aparelho entra de novo sozinho com a chave).
ZOIO_SESSION_DAYS=30

# Quem pode abrir o app: logins do Tailscale separados por vírgula.
# Vazio = qualquer aparelho da sua rede Tailscale.
# ZOIO_ALLOWED_USERS=jonassprocatti@github

# Alertas de movimento
ZOIO_ALERTS=1
# Só estas câmeras notificam (vazio = todas), ex.: 1,2
# ZOIO_NOTIFY_CHANNELS=
# Intervalo mínimo entre notificações da mesma câmera, em segundos.
ZOIO_NOTIFY_COOLDOWN=300

# Espaço máximo para vídeos baixados do DVR (MB). Os mais antigos saem primeiro.
ZOIO_CACHE_MAX_MB=2048

# Portaria (fase 2): placa ESP32 no portão com ESPHome, para a campainha, a
# fechadura do portão e as garagens. Veja docs/porteiro.md.
# Só funciona com a aprovação de aparelhos ligada, e só usa quem tiver a
# permissão de portaria (Ajustes › Aparelhos ou `sudo zoio aparelhos portao CÓDIGO`).
# ZOIO_GATE_HOST=192.168.15.20
# Chave da API da placa, a mesma do secrets.yaml dela (gere com `zoio portao chave`).
# ZOIO_GATE_KEY=
# Câmera do portão: aparece na portaria e tira a foto da campainha e de cada abertura.
# ZOIO_GATE_CAMERA=1
# Câmeras das garagens, na ordem (garagem 1, garagem 2). Sem a câmera, a
# garagem não fecha pelo app: fechar exige ver a garagem ao vivo.
# ZOIO_GARAGE_CAMERAS=2,3
# Nomes das garagens no app, na ordem.
# ZOIO_GARAGE_NAMES=Garagem 1,Garagem 2
# Quanto tempo o motor leva para abrir ou fechar, em segundos. Durante esse
# tempo o app mostra o botão Parar.
# ZOIO_GARAGE_TRAVEL=30
# ZOIO_GATE_PORT=6053
# ZOIO_GATE_NAME=zoio-porteiro

# ZOIO_LISTEN=127.0.0.1:8080
# ZOIO_DATA_DIR=/var/lib/zoio
