[Unit]
Description=go2rtc para o Zóio (vídeo ao vivo, sem recodificar)
After=network-online.target
Wants=network-online.target

[Service]
User=zoio
Group=zoio
Environment=ZOIO_ENV_FILE=/etc/zoio/zoio.env
# A configuração é gerada a partir do zoio.env a cada início (a senha não fica no repositório).
ExecStartPre=/opt/zoio/venv/bin/python -m zoio go2rtc-config /var/lib/zoio/go2rtc.yaml
ExecStart=/opt/zoio/bin/go2rtc -config /var/lib/zoio/go2rtc.yaml
Restart=always
RestartSec=5
MemoryMax=300M
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/zoio
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
